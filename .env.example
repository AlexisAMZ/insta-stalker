# Accès (OBLIGATOIRES en production : sans AMZ_PASSWORD l'accès reste fermé)
AMZ_PASSWORD=
AMZ_SECRET=
# Lancement : mettre 1 pour ouvrir l'accueil et autoriser l'indexation
SITE_LAUNCHED=
SITE_URL=https://unfollowd.com
# Viewer de stories
SCRAPFLY_KEY=
IG_SESSIONID=
# Base Neon : ajoutée automatiquement par l'intégration Vercel
DATABASE_URL=
# Inscrits réels pas encore importés dans la base (ajoutés au compteur public ; remettre à 0 après import)
WAITLIST_OFFSET=
# Double opt-in de la liste d'attente (OBLIGATOIRE : sans eux, les inscriptions restent fermées)
# AMZ_SECRET : au moins 32 caractères, différent de AMZ_PASSWORD (openssl rand -hex 32)
RESEND_API_KEY=
MAIL_FROM=
