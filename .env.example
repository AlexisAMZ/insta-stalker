# Accès (OBLIGATOIRES en production : sans AMZ_PASSWORD l'accès reste fermé)
AMZ_PASSWORD=
AMZ_SECRET=
# Lancement : mettre 1 pour ouvrir l'accueil et autoriser l'indexation
SITE_LAUNCHED=
SITE_URL=https://unfollowd.com
# Viewer de stories
SCRAPFLY_KEY=
IG_SESSIONID=
# Liste d'attente et limites d'usage (Upstash Redis REST ; KV_REST_API_URL/TOKEN acceptés aussi)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
